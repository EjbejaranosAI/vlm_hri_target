<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vlm_hri_target</name>
  <version>0.1.0</version>
  <description>VLM-based action/social-state recognition for HRI (ROS2 node, on top of dynamic_tracking's LiDAR+YOLO person tracks)</description>
  <maintainer email="edison.bejarano@itcl.es">Edison Bejarano</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>python3-ultralytics-pip</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
